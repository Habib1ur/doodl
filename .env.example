# =============================================================================
# DOODLIO ENVIRONMENT VARIABLES
# Copy this file to .env (root / server) and apps/web/.env.local (frontend)
# NEVER commit real secrets or .env files to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vercel / apps/web)
# Only NEXT_PUBLIC_* variables are exposed to the browser.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# BACKEND (Render / apps/server)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL (Transaction pooler or session pooler URL for runtime)
DATABASE_URL=postgresql://postgres:password@localhost:5432/doodlio?schema=public

# Direct connection URL for Prisma migrations (bypasses PgBouncer)
DIRECT_URL=postgresql://postgres:password@localhost:5432/doodlio?schema=public

# Secret used to sign player session tokens (generate a 32+ char random string)
SESSION_SECRET=change-me-to-a-secure-random-32-char-string

# Optional: Upstash Redis URL for multi-instance Socket.IO scaling
REDIS_URL=
